#!/bin/zsh
set -euo pipefail
export LC_ALL=C

BASE="/Library/Application Support/HighGAS"
TORROOT="$BASE/tor-expert"
TOR="$TORROOT/tor/tor"
GEOIP="$TORROOT/data/geoip"
GEOIP6="$TORROOT/data/geoip6"
DATADIR="$BASE/tor-data"
STATE="$BASE/tor-state"
PIDFILE="$BASE/tor.pid"
LOG="$BASE/tor.log"
SOCKS_PORT=39050
DNS_PORT=39053
CHECK_URL="https://lowgas.vercel.app/api/network-info"

/bin/mkdir -p "$DATADIR" >/dev/null 2>&1 || true

state() {
  [[ -f "$STATE" ]] || return 0
  /usr/bin/awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$STATE" 2>/dev/null || true
}

country_for_server() {
  case "${1:-}" in
    de-fra-01|de) print -r -- "de" ;;
    us-mia-01|us) print -r -- "us" ;;
    *) return 1 ;;
  esac
}

service_for_device() {
  /usr/sbin/networksetup -listnetworkserviceorder | /usr/bin/awk -v dev="$1" '
    /^\([0-9]+\) / {svc=$0; sub(/^\([0-9]+\) /,"",svc)}
    index($0,"Device: "dev) {sub(/^\*/,"",svc); print svc; exit}
  '
}

default_service() {
  local routeinfo dev
  routeinfo="$(/sbin/route -n get default 2>/dev/null || true)"
  dev="$(print -r -- "$routeinfo" | /usr/bin/awk '/interface:/{print $2;exit}')"
  [[ -n "$dev" ]] || return 1
  service_for_device "$dev"
}

proxy_value() {
  local key="$1" data="$2"
  print -r -- "$data" | /usr/bin/awk -F': ' -v k="$key" '$1==k{print $2;exit}'
}

kill_tor() {
  local pid=""
  if [[ -s "$PIDFILE" ]]; then
    pid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
  fi
  if [[ -n "$pid" ]] && /bin/kill -0 "$pid" >/dev/null 2>&1; then
    /bin/kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      /bin/kill -0 "$pid" >/dev/null 2>&1 || break
      /bin/sleep 0.1
    done
    /bin/kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  /bin/rm -f "$PIDFILE" >/dev/null 2>&1 || true
}

restore_network() {
  [[ -f "$STATE" ]] || return 0

  local svc dnsmode dnslist bypassmode bypasslist proxy current_server current_port current_enabled
  svc="$(state SERVICE)"
  dnsmode="$(state DNSMODE)"
  dnslist="$(state DNSLIST)"
  bypassmode="$(state BYPASSMODE)"
  bypasslist="$(state BYPASSLIST)"

  if [[ -n "$svc" ]]; then
    proxy="$(/usr/sbin/networksetup -getsocksfirewallproxy "$svc" 2>/dev/null || true)"
    current_server="$(proxy_value Server "$proxy")"
    current_port="$(proxy_value Port "$proxy")"
    current_enabled="$(proxy_value Enabled "$proxy")"

    if [[ "$current_enabled" == "Yes" && "$current_server" == "127.0.0.1" && "$current_port" == "$SOCKS_PORT" ]]; then
      /usr/sbin/networksetup -setsocksfirewallproxystate "$svc" off >/dev/null 2>&1 || true
    fi

    if [[ "$dnsmode" == "list" && -n "$dnslist" ]]; then
      local -a dnsarr
      dnsarr=( ${(s:,:)dnslist} )
      /usr/sbin/networksetup -setdnsservers "$svc" "${dnsarr[@]}" >/dev/null 2>&1 || true
    else
      /usr/sbin/networksetup -setdnsservers "$svc" Empty >/dev/null 2>&1 || true
    fi

    if [[ "$bypassmode" == "list" && -n "$bypasslist" ]]; then
      local -a bypassarr
      bypassarr=( ${(s:,:)bypasslist} )
      /usr/sbin/networksetup -setproxybypassdomains "$svc" "${bypassarr[@]}" >/dev/null 2>&1 || true
    else
      /usr/sbin/networksetup -setproxybypassdomains "$svc" Empty >/dev/null 2>&1 || true
    fi
  fi

  /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
}

down() {
  restore_network || true
  kill_tor || true
  /bin/rm -f "$STATE" >/dev/null 2>&1 || true
  print -r -- "disconnected"
}

up() {
  local server="$1" country expected svc proxy enabled dnsraw dnsmode dnslist bypassraw bypassmode bypasslist
  local booted=0 pid="" raw="" got="" verified=0

  country="$(country_for_server "$server")" || { print -u2 "Tor gratuito disponível apenas para Alemanha e Estados Unidos"; return 64; }
  expected="${(U)country}"

  [[ -x "$TOR" ]] || { print -u2 "motor Tor não está instalado"; return 2; }
  [[ -r "$GEOIP" && -r "$GEOIP6" ]] || { print -u2 "dados GeoIP do Tor não estão instalados"; return 2; }

  down >/dev/null 2>&1 || true

  svc="$(default_service)" || { print -u2 "não consegui identificar a conexão de internet ativa"; return 3; }
  [[ -n "$svc" ]] || { print -u2 "não consegui identificar o serviço de rede ativo"; return 3; }

  proxy="$(/usr/sbin/networksetup -getsocksfirewallproxy "$svc" 2>/dev/null || true)"
  enabled="$(proxy_value Enabled "$proxy")"
  if [[ "$enabled" == "Yes" ]]; then
    print -u2 "já existe um proxy SOCKS configurado no macOS; o HighGAS não vai sobrescrevê-lo"
    return 4
  fi

  dnsraw="$(/usr/sbin/networksetup -getdnsservers "$svc" 2>/dev/null || true)"
  if [[ -z "$dnsraw" || "$dnsraw" == There\ aren't\ any* ]]; then
    dnsmode="empty"
    dnslist=""
  else
    dnsmode="list"
    dnslist="${dnsraw//$'\n'/,}"
  fi

  bypassraw="$(/usr/sbin/networksetup -getproxybypassdomains "$svc" 2>/dev/null || true)"
  if [[ -z "$bypassraw" || "$bypassraw" == There\ aren't\ any* ]]; then
    bypassmode="empty"
    bypasslist=""
  else
    bypassmode="list"
    bypasslist="${bypassraw//$'\n'/,}"
  fi

  /bin/mkdir -p "$DATADIR"
  /bin/chmod 700 "$DATADIR" >/dev/null 2>&1 || true
  : > "$LOG"
  /bin/rm -f "$PIDFILE"

  "$TOR" \
    --ClientOnly 1 \
    --RunAsDaemon 1 \
    --AvoidDiskWrites 1 \
    --ClientUseIPv6 0 \
    --SocksPort "127.0.0.1:$SOCKS_PORT" \
    --DNSPort "127.0.0.1:$DNS_PORT" \
    --DataDirectory "$DATADIR" \
    --GeoIPFile "$GEOIP" \
    --GeoIPv6File "$GEOIP6" \
    --ExitNodes "{$country}" \
    --PidFile "$PIDFILE" \
    --Log "notice file $LOG" >/dev/null 2>&1 || {
      print -u2 "o Tor não conseguiu iniciar"
      kill_tor
      return 5
    }

  for _ in {1..50}; do
    [[ -s "$PIDFILE" ]] && break
    /bin/sleep 0.1
  done
  pid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] || { print -u2 "Tor iniciou sem registrar PID"; kill_tor; return 5; }

  for _ in {1..90}; do
    if /usr/bin/grep -q "Bootstrapped 100%" "$LOG" 2>/dev/null; then
      booted=1
      break
    fi
    if ! /bin/kill -0 "$pid" >/dev/null 2>&1; then
      print -u2 "Tor encerrou antes de conectar à rede"
      kill_tor
      return 6
    fi
    /bin/sleep 1
  done

  [[ "$booted" -eq 1 ]] || {
    print -u2 "Tor demorou demais para conectar; tente novamente"
    kill_tor
    return 7
  }

  # Confere o país pelo mesmo endpoint que o painel usa. Se a consulta estiver
  # temporariamente indisponível, a seleção ExitNodes do próprio Tor continua valendo.
  for _ in {1..4}; do
    raw="$(/usr/bin/curl -fsS --max-time 12 --socks5-hostname "127.0.0.1:$SOCKS_PORT" "$CHECK_URL?ts=$(/bin/date +%s)" 2>/dev/null || true)"
    got="$(print -r -- "$raw" | /usr/bin/sed -n 's/.*"country"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | /usr/bin/tr '[:lower:]' '[:upper:]')"
    if [[ "$got" == "$expected" ]]; then
      verified=1
      break
    fi
    if [[ -n "$got" && "$got" != "$expected" ]]; then
      /bin/sleep 1
      continue
    fi
    /bin/sleep 1
  done

  if [[ -n "$got" && "$verified" -ne 1 ]]; then
    print -u2 "a saída Tor não correspondeu ao país solicitado ($got em vez de $expected)"
    kill_tor
    return 8
  fi

  {
    print -r -- "SERVICE=$svc"
    print -r -- "DNSMODE=$dnsmode"
    print -r -- "DNSLIST=$dnslist"
    print -r -- "BYPASSMODE=$bypassmode"
    print -r -- "BYPASSLIST=$bypasslist"
    print -r -- "COUNTRY=$country"
    print -r -- "SERVER=$server"
    print -r -- "STARTED_AT=$(/bin/date +%s)"
  } > "$STATE"
  /bin/chmod 600 "$STATE"

  local -a bypassarr
  bypassarr=()
  if [[ "$bypassmode" == "list" && -n "$bypasslist" ]]; then
    bypassarr=( ${(s:,:)bypasslist} )
  fi
  bypassarr+=("localhost" "127.0.0.1")

  if ! /usr/sbin/networksetup -setproxybypassdomains "$svc" "${bypassarr[@]}" >/dev/null 2>&1 || \
     ! /usr/sbin/networksetup -setdnsservers "$svc" 127.0.0.1 >/dev/null 2>&1 || \
     ! /usr/sbin/networksetup -setsocksfirewallproxy "$svc" 127.0.0.1 "$SOCKS_PORT" off >/dev/null 2>&1 || \
     ! /usr/sbin/networksetup -setsocksfirewallproxystate "$svc" on >/dev/null 2>&1; then
    print -u2 "não consegui ativar o proxy Tor no macOS"
    down >/dev/null 2>&1 || true
    return 9
  fi

  /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
  print -r -- "connected tor $country $server"
}

status() {
  if [[ ! -f "$STATE" ]]; then
    print -r -- "disconnected"
    return 0
  fi

  local pid country server svc proxy enabled pserver pport started
  pid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
  country="$(state COUNTRY)"
  server="$(state SERVER)"
  svc="$(state SERVICE)"
  started="$(state STARTED_AT)"

  if [[ -z "$pid" || -z "$svc" ]] || ! /bin/kill -0 "$pid" >/dev/null 2>&1; then
    down >/dev/null 2>&1 || true
    print -r -- "disconnected"
    return 0
  fi

  proxy="$(/usr/sbin/networksetup -getsocksfirewallproxy "$svc" 2>/dev/null || true)"
  enabled="$(proxy_value Enabled "$proxy")"
  pserver="$(proxy_value Server "$proxy")"
  pport="$(proxy_value Port "$proxy")"

  if [[ "$enabled" != "Yes" || "$pserver" != "127.0.0.1" || "$pport" != "$SOCKS_PORT" ]]; then
    down >/dev/null 2>&1 || true
    print -r -- "disconnected"
    return 0
  fi

  print -r -- "connected tor $country $server $started"
}

recover() {
  if [[ -f "$STATE" ]]; then
    down >/dev/null 2>&1 || true
  else
    kill_tor || true
  fi
  print -r -- "recovered"
}

case "${1:-}" in
  up) [[ $# -eq 2 ]] || exit 64; up "$2" ;;
  down) down ;;
  status) status ;;
  recover) recover ;;
  *) print -u2 "usage: $0 up SERVER|down|status|recover"; exit 64 ;;
esac
