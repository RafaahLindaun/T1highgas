#!/bin/zsh
set -euo pipefail
export LC_ALL=C

BASE="/Library/Application Support/HighGAS"
TORROOT="$BASE/tor-expert"
TOR="$TORROOT/tor/tor"
TUN2SOCKS="$BASE/tun2socks"
GEOIP="$TORROOT/data/geoip"
GEOIP6="$TORROOT/data/geoip6"
RUNTIME="$BASE/tor-runtime"
DATADIR="$RUNTIME/data"
STATE="$BASE/tor-state"
PIDFILE="$RUNTIME/tor.pid"
TUNPID="$RUNTIME/tun2socks.pid"
LOG="$RUNTIME/tor.log"
TUNLOG="$RUNTIME/tun2socks.log"
TUNNAME="$RUNTIME/tun.name"
PFTOKEN="$RUNTIME/pf.token"
PFANCHOR="com.apple/highgas"
PFUSER="_www"
SOCKS_PORT=39050
# O resolver do macOS consulta DNS em 53; usar uma porta alta aqui faria
# networksetup apontar para 127.0.0.1 sem existir um servidor DNS nessa porta.
DNS_PORT=53
TUN_ADDR="198.18.0.1"
CHECK_URL="https://lowgas.vercel.app/api/network-info"
IPV6_CHECK_URL="https://api64.ipify.org"
# Cobre todo IPv4 público sem capturar 0/8 nem 127/8, preservando localhost.
ROUTES=(1.0.0.0/8 2.0.0.0/7 4.0.0.0/6 8.0.0.0/5 16.0.0.0/4 32.0.0.0/3 64.0.0.0/2 128.0.0.0/1)
ROUTE_PROBES=(1.1.1.1 2.2.2.2 4.4.4.4 8.8.8.8 16.0.0.1 32.0.0.1 64.0.0.1 128.0.0.1)

/bin/mkdir -p "$RUNTIME" "$DATADIR" >/dev/null 2>&1 || true

state() {
  [[ -f "$STATE" ]] || return 0
  /usr/bin/awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$STATE" 2>/dev/null || true
}

country_for_server() {
  case "${1:-}" in
    de-fra-01|de) print -r -- "de" ;;
    us-mia-01|us) print -r -- "us" ;;
    *) return 1 ;;
  esac
}

service_for_device() {
  /usr/sbin/networksetup -listnetworkserviceorder | /usr/bin/awk -v dev="$1" '
    /^\([0-9]+\) / {svc=$0; sub(/^\([0-9]+\) /,"",svc)}
    index($0,"Device: "dev) {sub(/^\*/,"",svc); print svc; exit}
  '
}

default_route() {
  /sbin/route -n get default 2>/dev/null || true
}

proxy_value() {
  local key="$1" data="$2"
  print -r -- "$data" | /usr/bin/awk -F': ' -v k="$key" '$1==k{print $2;exit}'
}

kill_pidfile() {
  local file="$1" pid=""
  [[ -s "$file" ]] && pid="$(/bin/cat "$file" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && /bin/kill -0 "$pid" >/dev/null 2>&1; then
    /bin/kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..30}; do
      /bin/kill -0 "$pid" >/dev/null 2>&1 || break
      /bin/sleep 0.1
    done
    /bin/kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  /bin/rm -f "$file" >/dev/null 2>&1 || true
}

remove_routes() {
  local iface="$(state IFACE)" r
  [[ -n "$iface" ]] || return 0
  for r in "${ROUTES[@]}"; do
    /sbin/route -q -n delete -inet "$r" -interface "$iface" >/dev/null 2>&1 || true
  done
}

restore_dns() {
  local svc="$(state SERVICE)" mode="$(state DNSMODE)" list="$(state DNSLIST)"
  [[ -n "$svc" ]] || return 0
  if [[ "$mode" == "list" && -n "$list" ]]; then
    local -a arr
    arr=( ${(s:,:)list} )
    /usr/sbin/networksetup -setdnsservers "$svc" "${arr[@]}" >/dev/null 2>&1 || true
  else
    /usr/sbin/networksetup -setdnsservers "$svc" Empty >/dev/null 2>&1 || true
  fi
  /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
}

# Remove configuração deixada por builds antigos que usavam proxy do sistema.
restore_legacy_proxy() {
  local svc="$(state SERVICE)" proxy server port enabled
  [[ -n "$svc" ]] || return 0
  proxy="$(/usr/sbin/networksetup -getsocksfirewallproxy "$svc" 2>/dev/null || true)"
  server="$(proxy_value Server "$proxy")"
  port="$(proxy_value Port "$proxy")"
  enabled="$(proxy_value Enabled "$proxy")"
  if [[ "$enabled" == "Yes" && "$server" == "127.0.0.1" && "$port" == "$SOCKS_PORT" ]]; then
    /usr/sbin/networksetup -setsocksfirewallproxystate "$svc" off >/dev/null 2>&1 || true
  fi
}

remove_pf() {
  /sbin/pfctl -a "$PFANCHOR" -F all >/dev/null 2>&1 || true
  if [[ -s "$PFTOKEN" ]]; then
    local token="$(/bin/cat "$PFTOKEN" 2>/dev/null || true)"
    [[ -n "$token" ]] && /sbin/pfctl -X "$token" >/dev/null 2>&1 || true
  fi
  /bin/rm -f "$PFTOKEN" >/dev/null 2>&1 || true
}

down() {
  # Ordem fail-closed: primeiro retira rotas TUN mantendo PF ativo; só depois
  # restaura rede e remove o kill switch.
  restore_legacy_proxy || true
  remove_routes || true
  restore_dns || true
  remove_pf || true
  kill_pidfile "$TUNPID" || true
  kill_pidfile "$PIDFILE" || true
  /bin/rm -f "$TUNNAME" "$STATE" >/dev/null 2>&1 || true
  /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
  print -r -- "disconnected"
}

choose_utun() {
  local n
  for n in {230..249}; do
    if ! /sbin/ifconfig "utun$n" >/dev/null 2>&1; then
      print -r -- "utun$n"
      return 0
    fi
  done
  return 1
}

save_dns_state() {
  local svc="$1" raw
  raw="$(/usr/sbin/networksetup -getdnsservers "$svc" 2>/dev/null || true)"
  if [[ -z "$raw" || "$raw" == *"There aren't any"* ]]; then
    print -r -- "empty|"
  else
    print -r -- "list|${raw//$'\n'/,}"
  fi
}

baseline_ip() {
  local dev="$1" raw
  raw="$(/usr/bin/curl -4 -fsS --interface "$dev" --connect-timeout 4 --max-time 12 -H 'Accept: application/json' "$CHECK_URL?ts=$(/bin/date +%s)" 2>/dev/null || true)"
  print -r -- "$raw" | /usr/bin/sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

pf_enable_and_load() {
  local dev="$1" gw="$2" iface="${3:-}" flush_states="${4:-no}" pfstate rules token=""
  rules="$(/usr/bin/mktemp -t highgas-pf).conf"
  {
    print -r -- "pass out quick on lo0 all"
    print -r -- "pass out quick on $dev inet proto tcp user $PFUSER keep state"
    if [[ -n "$iface" ]]; then
      print -r -- "pass out quick on $iface route-to ($dev $gw) inet proto tcp user $PFUSER keep state"
    fi
    print -r -- "block drop out quick on $dev inet all"
    print -r -- "block drop out quick inet6 all"
  } > "$rules"

  /sbin/pfctl -nf "$rules" >/dev/null 2>&1 || { /bin/rm -f "$rules"; print -u2 "o kill switch do macOS rejeitou as regras de segurança"; return 1; }

  pfstate="$(/sbin/pfctl -s info 2>/dev/null | /usr/bin/awk '/Status:/{print $2;exit}')"
  if [[ "$pfstate" != "Enabled" ]]; then
    token="$(/sbin/pfctl -E 2>&1 | /usr/bin/sed -n 's/.*Token[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | /usr/bin/tail -1)"
    [[ -n "$token" ]] && print -r -- "$token" > "$PFTOKEN"
  fi

  /sbin/pfctl -a "$PFANCHOR" -f "$rules" >/dev/null 2>&1 || {
    /bin/rm -f "$rules"
    remove_pf
    print -u2 "não consegui ativar o kill switch do HighGAS"
    return 1
  }
  /bin/rm -f "$rules"

  # O primeiro carregamento acontece ANTES do Tor existir. Assim podemos
  # eliminar todos os states diretos antigos sem matar o circuito Tor.
  if [[ "$flush_states" == "yes" ]]; then
    /sbin/pfctl -F states >/dev/null 2>&1 || true
  fi
  return 0
}

dns_probe() {
  [[ -x /usr/bin/dig ]] || return 1
  /usr/bin/dig +time=3 +tries=1 +short @127.0.0.1 -p "$DNS_PORT" lowgas.vercel.app A 2>/dev/null | /usr/bin/grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

routes_ok() {
  local iface="$1" probe routeif
  [[ -n "$iface" ]] || return 1
  for probe in "${ROUTE_PROBES[@]}"; do
    routeif="$(/sbin/route -n get "$probe" 2>/dev/null | /usr/bin/awk '/interface:/{print $2;exit}')"
    [[ "$routeif" == "$iface" ]] || return 1
  done
  return 0
}

tor_probe() {
  local expected="$1" raw ip country
  raw="$(/usr/bin/curl -4 -fsS --socks5-hostname "127.0.0.1:$SOCKS_PORT" --connect-timeout 8 --max-time 25 -H 'Accept: application/json' "$CHECK_URL?torprobe=$(/bin/date +%s)" 2>/dev/null || true)"
  ip="$(print -r -- "$raw" | /usr/bin/sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  country="$(print -r -- "$raw" | /usr/bin/sed -n 's/.*"country"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | /usr/bin/tr '[:lower:]' '[:upper:]')"
  [[ -n "$ip" && "$country" == "$expected" ]] || return 1
  print -r -- "$ip|$country"
}

quick_verify() {
  local iface="$(state IFACE)" svc="$(state SERVICE)" dev="$(state DEVICE)" torpid="" tunpid="" dnsraw="" pfrules=""
  [[ -s "$PIDFILE" && -s "$TUNPID" && -n "$iface" && -n "$svc" && -n "$dev" ]] || return 1
  torpid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
  tunpid="$(/bin/cat "$TUNPID" 2>/dev/null || true)"
  [[ -n "$torpid" && -n "$tunpid" ]] || return 1
  /bin/kill -0 "$torpid" >/dev/null 2>&1 || return 1
  /bin/kill -0 "$tunpid" >/dev/null 2>&1 || return 1
  /sbin/ifconfig "$iface" >/dev/null 2>&1 || return 1
  dnsraw="$(/usr/sbin/networksetup -getdnsservers "$svc" 2>/dev/null || true)"
  [[ "$dnsraw" == "127.0.0.1" ]] || return 1
  /usr/sbin/lsof -nP -a -p "$torpid" -iUDP:"$DNS_PORT" >/dev/null 2>&1 || return 1
  dns_probe || return 1
  routes_ok "$iface" || return 1
  pfrules="$(/sbin/pfctl -a "$PFANCHOR" -sr 2>/dev/null || true)"
  print -r -- "$pfrules" | /usr/bin/grep -q "block drop out quick on $dev inet" || return 1
  print -r -- "$pfrules" | /usr/bin/grep -q "block drop out quick inet6" || return 1
  return 0
}

verification_lines() {
  local expected="$(state EXPECTED)" baseline="$(state BASELINE_IP)" svc="$(state SERVICE)" iface="$(state IFACE)" dev="$(state DEVICE)"
  local ip="" country="" raw="" dnsraw="" pfrules="" ipv6ok=0 ipok=0 countryok=0 dnsok=0 routeok=0 torpid=""

  if [[ -n "$expected" && -n "$iface" ]]; then
    raw="$(/usr/bin/curl -4 -fsS --connect-timeout 6 --max-time 25 -H 'Accept: application/json' "$CHECK_URL?ts=$(/bin/date +%s)" 2>/dev/null || true)"
    ip="$(print -r -- "$raw" | /usr/bin/sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    country="$(print -r -- "$raw" | /usr/bin/sed -n 's/.*"country"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | /usr/bin/tr '[:lower:]' '[:upper:]')"
    [[ -n "$ip" && -n "$baseline" && "$ip" != "$baseline" ]] && ipok=1
    [[ "$country" == "$expected" ]] && countryok=1

    torpid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
    dnsraw="$(/usr/sbin/networksetup -getdnsservers "$svc" 2>/dev/null || true)"
    if [[ "$dnsraw" == "127.0.0.1" && -n "$torpid" ]] && /usr/sbin/lsof -nP -a -p "$torpid" -iUDP:"$DNS_PORT" >/dev/null 2>&1 && dns_probe; then
      dnsok=1
    fi

    # IPv6 não é enviado ao Tor: é explicitamente bloqueado para não vazar.
    if ! /usr/bin/curl -6 -fsS --connect-timeout 2 --max-time 5 "$IPV6_CHECK_URL" >/dev/null 2>&1; then
      ipv6ok=1
    fi

    pfrules="$(/sbin/pfctl -a "$PFANCHOR" -sr 2>/dev/null || true)"
    if routes_ok "$iface" && print -r -- "$pfrules" | /usr/bin/grep -q "block drop out quick on $dev inet" && print -r -- "$pfrules" | /usr/bin/grep -q "block drop out quick inet6"; then
      routeok=1
    fi
  fi

  print -r -- "IP=$ip"
  print -r -- "COUNTRY=$country"
  print -r -- "IP_CHANGED=$ipok"
  print -r -- "COUNTRY_OK=$countryok"
  print -r -- "DNS_OK=$dnsok"
  print -r -- "IPV6_OK=$ipv6ok"
  print -r -- "ROUTE_OK=$routeok"
  if [[ "$ipok" -eq 1 && "$countryok" -eq 1 && "$dnsok" -eq 1 && "$ipv6ok" -eq 1 && "$routeok" -eq 1 ]]; then
    print -r -- "VERIFIED=1"
    return 0
  fi
  print -r -- "VERIFIED=0"
  return 1
}

up() {
  local server="$1" country expected routeinfo gw dev svc dnsstate dnsmode dnslist baseline iface torpid tunpid booted=0 torprobe="" verify=""
  country="$(country_for_server "$server")" || { print -u2 "Tor gratuito disponível apenas para Alemanha e Estados Unidos"; return 64; }
  expected="${(U)country}"

  [[ -x "$TOR" ]] || { print -u2 "motor Tor não está instalado"; return 2; }
  [[ -x "$TUN2SOCKS" ]] || { print -u2 "motor Full Tunnel não está instalado"; return 2; }
  [[ -r "$GEOIP" && -r "$GEOIP6" ]] || { print -u2 "dados GeoIP do Tor não estão instalados"; return 2; }
  [[ -x /usr/bin/dig ]] || { print -u2 "verificador DNS do macOS não foi encontrado"; return 2; }
  /usr/bin/id "$PFUSER" >/dev/null 2>&1 || { print -u2 "usuário seguro do sistema não encontrado"; return 2; }

  down >/dev/null 2>&1 || true

  routeinfo="$(default_route)"
  gw="$(print -r -- "$routeinfo" | /usr/bin/awk '/gateway:/{print $2;exit}')"
  dev="$(print -r -- "$routeinfo" | /usr/bin/awk '/interface:/{print $2;exit}')"
  [[ -n "$gw" && -n "$dev" ]] || { print -u2 "não consegui identificar a rota física de internet"; return 3; }
  svc="$(service_for_device "$dev")"
  [[ -n "$svc" ]] || { print -u2 "não consegui identificar o serviço de internet ativo"; return 3; }

  dnsstate="$(save_dns_state "$svc")"
  dnsmode="${dnsstate%%|*}"
  dnslist="${dnsstate#*|}"
  baseline="$(baseline_ip "$dev")"
  [[ -n "$baseline" ]] || { print -u2 "não consegui registrar o IP anterior antes de ligar"; return 3; }

  /bin/rm -rf "$DATADIR"
  /bin/mkdir -p "$DATADIR"
  /usr/sbin/chown -R "$PFUSER" "$RUNTIME"
  /bin/chmod 700 "$RUNTIME" "$DATADIR" >/dev/null 2>&1 || true
  : > "$LOG"
  : > "$TUNLOG"
  /usr/sbin/chown "$PFUSER" "$LOG" "$TUNLOG"
  /bin/rm -f "$PIDFILE" "$TUNPID" "$PFTOKEN" "$TUNNAME"

  # Grave o estado ANTES de ativar o PF para que qualquer falha possa
  # sempre restaurar DNS/rede de forma determinística.
  {
    print -r -- "SERVICE=$svc"
    print -r -- "DEVICE=$dev"
    print -r -- "GATEWAY=$gw"
    print -r -- "DNSMODE=$dnsmode"
    print -r -- "DNSLIST=$dnslist"
    print -r -- "COUNTRY=$country"
    print -r -- "EXPECTED=$expected"
    print -r -- "SERVER=$server"
    print -r -- "BASELINE_IP=$baseline"
    print -r -- "STARTED_AT=$(/bin/date +%s)"
  } > "$STATE"
  /bin/chmod 600 "$STATE"

  # Fase 1 fail-closed: bloqueia tráfego direto e elimina states antigos
  # ANTES do Tor existir. Somente o usuário isolado _www poderá sair.
  pf_enable_and_load "$dev" "$gw" "" yes || { down >/dev/null 2>&1 || true; return 9; }

  "$TOR" \
    --User "$PFUSER" \
    --ClientOnly 1 \
    --RunAsDaemon 1 \
    --AvoidDiskWrites 1 \
    --ClientUseIPv6 0 \
    --SocksPort "127.0.0.1:$SOCKS_PORT" \
    --DNSPort "127.0.0.1:$DNS_PORT" \
    --DataDirectory "$DATADIR" \
    --GeoIPFile "$GEOIP" \
    --GeoIPv6File "$GEOIP6" \
    --ExitNodes "{$country}" \
    --StrictNodes 1 \
    --PidFile "$PIDFILE" \
    --Log "notice file $LOG" >/dev/null 2>&1 || { print -u2 "o Tor não conseguiu iniciar sob o kill switch"; down >/dev/null 2>&1 || true; return 5; }

  for _ in {1..100}; do
    [[ -s "$PIDFILE" ]] && break
    /bin/sleep 0.1
  done
  torpid="$(/bin/cat "$PIDFILE" 2>/dev/null || true)"
  [[ -n "$torpid" ]] || { print -u2 "Tor iniciou sem registrar PID"; down >/dev/null 2>&1 || true; return 5; }

  for _ in {1..150}; do
    if /usr/bin/grep -q "Bootstrapped 100%" "$LOG" 2>/dev/null; then booted=1; break; fi
    /bin/kill -0 "$torpid" >/dev/null 2>&1 || { print -u2 "Tor encerrou antes de conectar"; down >/dev/null 2>&1 || true; return 6; }
    /bin/sleep 1
  done
  [[ "$booted" -eq 1 ]] || { print -u2 "Tor demorou demais para conectar"; down >/dev/null 2>&1 || true; return 7; }

  torprobe="$(tor_probe "$expected" 2>/dev/null || true)"
  [[ -n "$torprobe" ]] || { print -u2 "o Tor conectou, mas não confirmou a saída $expected"; down >/dev/null 2>&1 || true; return 7; }
  print -r -- "TOR_PROBE_IP=${torprobe%%|*}" >> "$STATE"

  /usr/sbin/lsof -nP -a -p "$torpid" -iUDP:"$DNS_PORT" >/dev/null 2>&1 || { print -u2 "o DNS protegido do Tor não iniciou"; down >/dev/null 2>&1 || true; return 7; }
  dns_probe || { print -u2 "o DNS protegido não respondeu"; down >/dev/null 2>&1 || true; return 7; }

  # Fase 2: cria o utun só depois de o Tor já estar comprovadamente vivo.
  /usr/bin/env WG_TUN_NAME_FILE="$TUNNAME" "$TUN2SOCKS" --device utun --proxy "socks5://127.0.0.1:$SOCKS_PORT" >"$TUNLOG" 2>&1 &
  tunpid=$!
  print -r -- "$tunpid" > "$TUNPID"
  for _ in {1..100}; do
    [[ -s "$TUNNAME" ]] && break
    /bin/kill -0 "$tunpid" >/dev/null 2>&1 || { print -u2 "o motor Full Tunnel encerrou ao iniciar"; [[ -s "$TUNLOG" ]] && /bin/cat "$TUNLOG" >&2; down >/dev/null 2>&1 || true; return 10; }
    /bin/sleep 0.1
  done
  [[ -s "$TUNNAME" ]] || { print -u2 "o macOS não informou a interface Full Tunnel"; down >/dev/null 2>&1 || true; return 10; }
  iface="$(/bin/cat "$TUNNAME" 2>/dev/null | /usr/bin/tr -d '\r\n')"
  [[ "$iface" =~ ^utun[0-9]+$ ]] || { print -u2 "nome de interface Full Tunnel inválido: $iface"; down >/dev/null 2>&1 || true; return 10; }
  /sbin/ifconfig "$iface" >/dev/null 2>&1 || { print -u2 "a interface Full Tunnel não foi criada"; down >/dev/null 2>&1 || true; return 10; }
  print -r -- "IFACE=$iface" >> "$STATE"
  /sbin/ifconfig "$iface" inet "$TUN_ADDR" "$TUN_ADDR" up >/dev/null

  # Recarrega o anchor SEM limpar states. Os únicos states diretos que
  # nasceram após a limpeza inicial são do Tor isolado (_www).
  pf_enable_and_load "$dev" "$gw" "$iface" no || { down >/dev/null 2>&1 || true; return 9; }

  local r
  for r in "${ROUTES[@]}"; do
    /sbin/route -q -n add -inet "$r" -interface "$iface" >/dev/null 2>&1 || { print -u2 "não consegui proteger a rota $r"; down >/dev/null 2>&1 || true; return 11; }
  done
  /usr/sbin/networksetup -setdnsservers "$svc" 127.0.0.1 >/dev/null || { print -u2 "não consegui proteger o DNS"; down >/dev/null 2>&1 || true; return 12; }
  /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true

  # Aguarda o stack do macOS convergir e exige todas as provas antes de
  # declarar conectado: IP mudou, país, DNS, IPv6 e rotas/kill switch.
  for _ in {1..30}; do
    verify="$(verification_lines 2>/dev/null || true)"
    print -r -- "$verify" | /usr/bin/grep -q '^VERIFIED=1$' && break
    /bin/sleep 1
  done
  if ! print -r -- "$verify" | /usr/bin/grep -q '^VERIFIED=1$'; then
    print -u2 "a verificação completa não passou; o HighGAS desligou para evitar vazamento"
    print -u2 -- "$verify"
    down >/dev/null 2>&1 || true
    return 13
  fi

  print -r -- "connected tor $country $server $(state STARTED_AT)"
}

status() {
  if [[ ! -f "$STATE" ]]; then print -r -- "disconnected"; return 0; fi
  local server="$(state SERVER)" country="$(state COUNTRY)" started="$(state STARTED_AT)"
  if ! quick_verify; then
    down >/dev/null 2>&1 || true
    print -r -- "disconnected"
    return 0
  fi
  print -r -- "connected tor $country $server $started"
}

verify() {
  [[ -f "$STATE" ]] || { print -r -- "VERIFIED=0"; return 1; }
  verification_lines
}

recover() {
  down >/dev/null 2>&1 || true
  print -r -- "recovered"
}

case "${1:-}" in
  up) [[ $# -eq 2 ]] || exit 64; up "$2" ;;
  down) down ;;
  status) status ;;
  verify) verify ;;
  recover) recover ;;
  *) print -u2 "usage: $0 up SERVER|down|status|verify|recover"; exit 64 ;;
esac
